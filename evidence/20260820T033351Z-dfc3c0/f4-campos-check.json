{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "unique": true,
      "description": "Identificador do documento, gerado pelo MongoDB.",
      "classification": "internal"
    },
    "data_pedido": {
      "type": "string",
      "format": "date",
      "description": "Momento em que o pedido foi criado.",
      "classification": "internal"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total do pedido em reais.",
      "classification": "internal"
    },
    "cliente": {
      "type": "object",
      "properties": {
        "cpf": {
          "type": "string",
          "description": "CPF do cliente.",
          "tags": [
            "pii"
          ],
          "classification": "restricted"
        },
        "nome_completo": {
          "type": "string",
          "description": "Nome civil do cliente.",
          "tags": [
            "pii"
          ],
          "classification": "confidential"
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "description": "Endereco de e-mail do cliente.",
          "tags": [
            "pii"
          ],
          "classification": "confidential"
        }
      },
      "required": [
        "cpf",
        "nome_completo"
      ],
      "description": "Dados do cliente, embutidos no documento do pedido \u2014 padrao comum em MongoDB para evitar join."
    },
    "entregas": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "cep": {
            "type": [
              "string",
              "null"
            ],
            "description": "CEP do endereco de entrega.",
            "tags": [
              "pii"
            ],
            "classification": "confidential"
          },
          "data_nascimento_recebedor": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Data de nascimento de quem recebeu, coletada na entrega.",
            "tags": [
              "pii"
            ],
            "classification": "confidential"
          }
        },
        "required": []
      },
      "description": "Tentativas de entrega do pedido."
    }
  },
  "required": [
    "_id",
    "data_pedido",
    "valor_total",
    "cliente"
  ],
  "description": "Um documento por pedido."
}